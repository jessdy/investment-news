# 大模型模式：claude-cli 或 api
LLM_PROVIDER="claude-cli"

# LLM_PROVIDER=api 时填写以下三项
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 已认证服务号网页授权（AppSecret 仅保存在部署服务器）
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# 登录二维码有效期与登录会话有效期（秒）
AUTH_TICKET_TTL="300"
AUTH_SESSION_TTL="2592000"

# MySQL 数据源
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
MYSQL_CONNECT_TIMEOUT="10"
MYSQL_READ_TIMEOUT="20"
MYSQL_WRITE_TIMEOUT="20"

# 按收盘价 × 总份额估算总金额，跟踪金额最大的 N 只上交所 ETF
ETF_TOP_N="10"
# 跟踪指数每次回溯采集自然日数，覆盖最多 90 个交易日
ETF_INDEX_FETCH_DAYS="180"

# Docker Compose 可选配置
APP_PORT="8793"
IMAGE_NAME="investment-news"
IMAGE_TAG="latest"
# Docker 构建时的 Python 包镜像源
PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple"

# 生产环境公开访问地址，用于 canonical、sitemap 和结构化数据（不要以 / 结尾）
PUBLIC_BASE_URL="https://example.com"
