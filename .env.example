# 大模型模式：claude-cli 或 api
LLM_PROVIDER="claude-cli"

# LLM_PROVIDER=api 时填写以下三项
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# MySQL 数据源
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
MYSQL_CONNECT_TIMEOUT="10"
MYSQL_READ_TIMEOUT="20"
MYSQL_WRITE_TIMEOUT="20"

# Docker Compose 可选配置
APP_PORT="8793"
IMAGE_NAME="investment-news"
IMAGE_TAG="latest"
